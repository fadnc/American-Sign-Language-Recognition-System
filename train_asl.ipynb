import numpy as np
import matplotlib.pyplot as plt

data = np.load("training_history.npz")

plt.figure(figsize=(8,4))
plt.plot(data['accuracy'], label='Train Accuracy')
plt.plot(data['val_accuracy'], label='Validation Accuracy')
plt.title("ASL CNN Training Progress")
plt.xlabel("Epochs")
plt.ylabel("Accuracy")
plt.legend()
plt.show()

print("Final Validation Accuracy:", round(data['val_accuracy'][-1]*100, 2), "%")
